---
import "../assets/css/home.css";
const { title = "Amy Young — Researcher, Designer, Builder · Seattle" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/images/ZenCloud-logo-dk-trans.png" />
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body>
    <nav class="nav" id="nav">
    <div class="nav-inner">
      <div class="nav-logo">Amy Young</div>
      <div class="nav-links">
        <a href="/" class="active">Home</a>
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
        <a href="/posts">Articles</a>
      </div>
      <a class="nav-contact" href="#contact">Contact</a>
      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-panel">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
    <div class="nav-panel" id="nav-panel">
      <a href="/" class="active">Home</a>
      <a href="/projects">Projects</a>
      <a href="/about">About</a>
      <a href="/posts">Articles</a>
    </div>
  </nav>

    <slot />

    <!-- CONTACT — rebuilt 2026-08-06 on the About page's "Let's Connect" pattern:
         deep-purple ground, an inline compose panel that hands off to the mail client,
         and labelled social pills. Copy stays "Let's compare notes." (settled 2026-08-01)
         rather than the About page's generic "Let's Connect". -->
  <div class="shape-sec" id="contact">
    <div class="wrap ct-grid">
      <div class="ct-main">
      <div class="ct-lbl rv">Get in touch</div>
      <h2 class="ct-title rv">Let's compare notes.</h2>
      <p class="ct-lead rv">If you're building with AI in health, science, research, or marketing, I'd like to hear what you're working on.</p>

      <div class="ct-compose rv">
        <button class="ct-btn" id="ct-toggle" type="button" aria-expanded="false" aria-controls="ct-panel">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          Send me an email
        </button>

        <div class="ct-panel" id="ct-panel" hidden>
          <div class="ct-to"><span class="ct-to-k">To</span><span class="ct-to-v">amy@amyyoung.me</span></div>
          <label class="ct-sr" for="ct-subject">Subject</label>
          <input class="ct-input" id="ct-subject" type="text" placeholder="Subject">
          <label class="ct-sr" for="ct-body">Message</label>
          <textarea class="ct-textarea" id="ct-body" rows="5" placeholder="Your message..."></textarea>
          <div class="ct-panel-foot">
            <button class="ct-send" id="ct-send" type="button">Send <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></button>
            <button class="ct-cancel" id="ct-cancel" type="button">Cancel</button>
          </div>
          <p class="ct-note">This opens the message in your own email app. Nothing is sent from this page.</p>
        </div>
      </div>

      <div class="ct-socials rv">
        <a class="ct-pill" href="https://www.linkedin.com/in/amyyoung-data-ai/" target="_blank" rel="noopener"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"></path></svg><span>LinkedIn</span></a>
        <a class="ct-pill" href="https://bsky.app/profile/amyyoung1.bsky.social" target="_blank" rel="noopener"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 568 501" fill="currentColor"><path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.209C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.905 328.723 521.88 398.431 458.208 448c-121.06 91.648-174.341-22.879-196.208-52.309C240.041 425.121 186.76 539.648 65.7 448c-63.672-49.569-49.647-119.277 65.875-143.75C65.854 314.626-8.026 296.146 2.25 223.502 7.325 207.714 15.575 157.707 35.85 112.207 57.575 62.857 92.221 10.493 123.121 33.664z"></path></svg><span>Bluesky</span></a>
        <a class="ct-pill" href="https://github.com/amy-young" target="_blank" rel="noopener"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path></svg><span>GitHub</span></a>
        <a class="ct-pill" href="https://x.com/amyyoung" target="_blank" rel="noopener"><svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z"></path></svg><span>X / Twitter</span></a>
      </div>
      </div>

      <nav class="ct-map rv" aria-label="Site">
        <a href="/projects">Projects</a>
        <a href="/posts">Articles</a>
        <a href="/about">About</a>
        <!-- !! /resume DOES NOT EXIST. Added at Amy's request 2026-08-06; this link 404s
             until the page is built. DO NOT SHIP to main without creating it. -->
        <a href="/resume">Resume</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="foot">
    <div class="wrap">
      <!-- Stripped to the copyright 2026-08-06. Nav and socials moved up into the
           contact band's sitemap column, so repeating them here was duplication. -->
      <div class="foot-inner">
        <div class="foot-copy">© 2026 · Amy Young. All rights reserved.</div>
      </div>
    </div>
  </div>

    <div id="cursor-ring"></div>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>

<script>
const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => nav.classList.toggle('stuck', window.scrollY > 10), { passive: true });

    // Mobile hamburger
    const navToggle = document.querySelector('.nav-toggle');
    const navPanel = document.getElementById('nav-panel');
    if (nav && navToggle && navPanel) {
      const setMenu = (open) => {
        nav.classList.toggle('open', open);
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      navToggle.addEventListener('click', () => setMenu(!nav.classList.contains('open')));
      navPanel.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
      // Tap anywhere outside the nav closes it. The toggle lives inside .nav, so its own
      // click never reaches this and cannot fight the open/close it just performed.
      document.addEventListener('click', (e) => {
        // e.target is EventTarget, which nav.contains() will not accept — narrow it to a
        // Node first. This is also correct at runtime, not just a cast to quiet the checker.
        if (nav.classList.contains('open') && e.target instanceof Node && !nav.contains(e.target)) setMenu(false);
      });
      window.addEventListener('resize', () => { if (window.innerWidth > 760) setMenu(false); }, { passive: true });
    }

    // Contact compose panel. Hands the message to the visitor's own mail client via a
    // mailto: — the same approach the About page uses, so no form backend is involved
    // and nothing is submitted from this page.
    const ctToggle = document.getElementById('ct-toggle');
    const ctPanel = document.getElementById('ct-panel');
    const ctSend = document.getElementById('ct-send');
    const ctCancel = document.getElementById('ct-cancel');
    const ctSubject = document.getElementById('ct-subject');
    const ctBody = document.getElementById('ct-body');

    if (ctToggle && ctPanel) {
      const setCompose = (open: boolean) => {
        ctPanel.hidden = !open;
        ctToggle.setAttribute('aria-expanded', String(open));
        if (open && ctSubject instanceof HTMLInputElement) ctSubject.focus();
      };
      // !! because Astro types HTMLElement.hidden as string | boolean, not boolean.
      ctToggle.addEventListener('click', () => setCompose(!!ctPanel.hidden));
      ctCancel?.addEventListener('click', () => { setCompose(false); ctToggle.focus(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !ctPanel.hidden) { setCompose(false); ctToggle.focus(); }
      });
      ctSend?.addEventListener('click', () => {
        const subject = ctSubject instanceof HTMLInputElement ? ctSubject.value : '';
        const body = ctBody instanceof HTMLTextAreaElement ? ctBody.value : '';
        window.location.href =
          'mailto:amy@amyyoung.me?subject=' + encodeURIComponent(subject) +
          '&body=' + encodeURIComponent(body);
      });
    }

    // Hero "+" expanders — one open at a time
    document.querySelectorAll('.hero-svc-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.hero-svc');
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.hero-svc.open').forEach(o => {
          o.classList.remove('open');
          o.querySelector('.hero-svc-btn').setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Skill rows — the purple/white state follows the pointer and stays on the last row entered
    document.querySelectorAll('.skill-row').forEach(row => {
      const setActive = () => {
        document.querySelectorAll('.skill-row.active').forEach(r => r.classList.remove('active'));
        row.classList.add('active');
      };
      row.addEventListener('mouseenter', setActive);
      row.addEventListener('focusin', setActive);
    });

    const rvEls = document.querySelectorAll('.rv');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } });
    }, { threshold: 0, rootMargin: '0px 0px -30px 0px' });
    rvEls.forEach(el => obs.observe(el));
    setTimeout(() => rvEls.forEach(el => el.classList.add('in')), 400);

    // Custom cursor
    const ring = document.getElementById('cursor-ring');
    let mx = window.innerWidth / 2, my = window.innerHeight / 2;
    let rx = mx, ry = my;
    document.addEventListener('mousemove', e => {
      mx = e.clientX; my = e.clientY;
      document.body.classList.add('cursor-active');
    }, { passive: true });
    document.addEventListener('mousedown', () => document.body.classList.add('cursor-click'));
    document.addEventListener('mouseup',   () => document.body.classList.remove('cursor-click'));
    document.querySelectorAll('a, button, .proj-card, .blog-card, .why-card, .svc-arrow').forEach(el => {
      el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
      el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
    });
    (function tick() {
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      ring.style.left = rx + 'px';
      ring.style.top  = ry + 'px';
      requestAnimationFrame(tick);
    })();
</script>
