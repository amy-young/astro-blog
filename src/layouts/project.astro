---
import Layout from "./home.astro";

// Moved off the Aria theme onto the home.astro design system 2026-08-14, per
// handoff/posts-redesign/README.md in the PKA repo. Shares .article-body and the
// .post-head block with layouts/post.astro -- both are long-form templates.
//
// Reached via each markdown file's `layout:` frontmatter key, not by a route file --
// pages/project/[slug].astro just renders <Content />.
//
// Three things from the old layout are deliberately NOT carried over:
//
// 1. The generated hero panel. When a project had no heroImage the old layout drew a
//    gradient-and-dashed-border placeholder with the title inside it. The site settled on
//    2026-08-06 that text-forward beats fabricated imagery (same call that made /projects
//    text cards and removed the invented stat bar). heroImage renders when present;
//    nothing is invented when it is absent.
// 2. The emerald/amber/blue status palette. --accent #4D3A9A is the only hue on the site.
//    Status now reuses .pj-status/.pj-dot from /projects, which is the existing idiom.
// 3. Dark mode. The design system is light-only by Amy's ruling 2026-08-14.
//
// !! VOCABULARY MISMATCH, unresolved -- flagged to Amy 2026-08-14.
// This collection's schema allows status: active | building | shipped.
// /projects uses a different set: shipped | building | concept.
// They are also fed by different data: the index is a HARDCODED array in projects.astro,
// not this collection. Personal Knowledge System is "shipped" on the index and "active"
// in its own frontmatter, so the same project reports two states on two pages. Mapping
// below is a stopgap; the real fix is one vocabulary and one source.

interface Frontmatter {
  title: string;
  description: string;
  status: "active" | "building" | "shipped";
  category: "work" | "personal";
  tags?: string[];
  startDate?: string;
  liveUrl?: string;
  githubUrl?: string;
  downloadUrl?: string;
  heroImage?: string;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const {
  title, description, status, category,
  tags = [], startDate, liveUrl, githubUrl, downloadUrl, heroImage,
} = frontmatter;

const STATUS_LABEL: Record<Frontmatter["status"], string> = {
  active: "Active",
  building: "Building",
  shipped: "Shipped",
};

// Maps this schema's vocabulary onto the dot colours /projects already defines.
// "active" borrows the in-progress accent dot; see the mismatch note above.
const STATUS_DOT: Record<Frontmatter["status"], string> = {
  active: "building",
  building: "building",
  shipped: "shipped",
};

const CATEGORY_LABEL: Record<Frontmatter["category"], string> = {
  work: "Work project",
  personal: "Personal project",
};

const hasActions = Boolean(liveUrl || githubUrl || downloadUrl);
---

<Layout
  title={`${title} — Amy Young`}
  ogTitle={title}
  description={description}
  image={heroImage}
  ogType="article"
>
  <article class="sec">
    <div class="wrap">

      <header class="post-head">
        <a class="post-back rv" href="/projects">
          <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
          Projects
        </a>

        <div class="prj-badges rv">
          <span class="pj-status" data-s={STATUS_DOT[status]}>
            <span class="pj-dot"></span>{STATUS_LABEL[status]}
          </span>
          <span class="pj-cat">{CATEGORY_LABEL[category]}</span>
        </div>

        <h1 class="post-title rv">{title}</h1>

        <p class="post-desc rv">{description}</p>

        <div class="post-meta rv">
          {startDate && <span class="post-date">Started {startDate}</span>}
          {tags.length > 0 && (
            <div class="post-tags">
              {tags.map((t) => <span class="tag tag-accent">{t}</span>)}
            </div>
          )}
        </div>

        {hasActions && (
          <div class="prj-actions rv">
            {liveUrl && (
              <a class="btn btn-primary" href={liveUrl} target="_blank" rel="noopener">
                View live
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path></svg>
              </a>
            )}
            {githubUrl && (
              <a class="btn btn-outline" href={githubUrl} target="_blank" rel="noopener">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path></svg>
                GitHub
              </a>
            )}
            {downloadUrl && (
              <a class="btn btn-outline" href={downloadUrl} download>
                Download
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12M6 12l6 6 6-6M4 20h16"></path></svg>
              </a>
            )}
          </div>
        )}
      </header>

      {heroImage && (
        <figure class="prj-hero rv">
          <img src={heroImage} alt={`${title} — project hero`} loading="eager" decoding="async" />
        </figure>
      )}

      <div class="article-body rv">
        <slot />
      </div>

    </div>
  </article>
</Layout>
