---
import Layout from "./home.astro";

// Moved off the Aria theme onto the home.astro design system 2026-08-14, per
// handoff/posts-redesign/README.md in the PKA repo.
//
// The article body was styled entirely by Tailwind's `prose` before this
// (prose-sm prose lg:prose-lg dark:prose-invert). That does not come along, so the
// typographic scale now lives in home.css as .article-body and is shared with
// /project/<slug>.
//
// Dark mode ends here. The old main.astro layout carried the localStorage.dark_mode
// script and header.astro carried the toggle; the design system is light-only. Amy's
// ruling 2026-08-14, deliberate, not an oversight.
//
// Reached via each markdown file's `layout:` frontmatter key, not by a route file --
// pages/post/[slug].astro just renders <Content />.

interface Frontmatter {
  title: string;
  description?: string;
  dateFormatted?: string;
  tags?: string[];
  heroImage?: string;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const { title, description, dateFormatted, tags = [], heroImage } = frontmatter;
---

<Layout title={`${title} — Amy Young`}>
  <article class="sec">
    <div class="wrap">

      <header class="post-head">
        <a class="post-back rv" href="/posts">
          <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
          Writing
        </a>

        <h1 class="post-title rv">{title}</h1>

        {description && <p class="post-desc rv">{description}</p>}

        <div class="post-meta rv">
          {dateFormatted && <time class="post-date">{dateFormatted}</time>}
          {tags.length > 0 && (
            <div class="post-tags">
              {tags.map((t) => <span class="tag tag-accent">{t}</span>)}
            </div>
          )}
        </div>
      </header>

      {heroImage && (
        <figure class="prj-hero rv">
          <img src={heroImage} alt={`${title} — featured image`} loading="eager" decoding="async" />
        </figure>
      )}

      <div class="article-body rv">
        <slot />
      </div>

    </div>
  </article>
</Layout>
