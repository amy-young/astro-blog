      { k: "Claude Code", v: "skill authoring, memory architecture design, hook-based automation." },
      { k: "Codex and open-source models", v: "used alongside Claude, including self-hosted local models for private-zone work." },
      { k: "Landscape fluency", v: "evaluated and compared Claude Code, Cursor, and OpenAI Codex on model-switching tradeoffs, ADE positioning, and enterprise vs. personal-plan economics." },
