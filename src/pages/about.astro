---
import Layout from "../layouts/home.astro";

// Rebuilt 2026-08-07 in the homepage design system, replacing the Aria-theme page.
//
// Content provenance: built from "Amy Young - About v1.html" in the 2026-07-14 export,
// NOT the base version. The base version's career history was fabricated (Fintelo,
// Stackwise, Novo Craft Agency) and it carried a consulting "How I Work" process. v1 and
// v2 have identical visible text and had already replaced both with real content.
//
// Cut from v1, on Amy's ruling 2026-08-07:
//  - Three testimonials (James Sullivan, Maya Rodriguez, Tom Chen). Fabricated. Two of
//    them cited Fintelo and Stackwise, the fake companies v1 itself had already deleted.
//  - The "Let's Build Together" closing CTA. It pitched services, and the site selling
//    nothing is settled. The layout's contact band replaces it.
//
// Career journey CONFIRMED by Amy 2026-08-07. The CRG Research (1994-2011) and The Body
// Shop (1996-2009) overlap is correct and intentional: she ran both concurrently. Do not
// "fix" the dates.
//
// Copy rewritten against ventures/context/writing/style-guide.md -> "Site and Interface
// Copy". Five things in v1 tripped it: "AI Expertise" (self-grading), "Working at the edge
// of agentic AI" ("agentic" rejected as a permanent label), "at the crossroads of" (same
// construction as the banned "at the intersection of"), "Grounded in data, people, and
// systems thinking" (abstract stack), and "Beyond interface design" (leftover from the
// base version's UX-designer framing).

interface Capability { no: string; title: string; desc: string; }
interface Entry { name: string; org: string; yr: string; }
interface Role { yr: string; role: string; org: string; }

const CAPABILITIES: Capability[] = [
  {
    no: "01", title: "Claude Code Environment",
    desc: "Claude Code as a daily-driver dev environment: 30+ custom skills, hooks, and multi-agent routing across dev, content, research, and ops.",
  },
  {
    no: "02", title: "Harness and Hooks",
    desc: "Direct control over Claude Code's harness layer: deterministic hooks, permission tuning, and a clear line between what gets automated and what stays with the model.",
  },
  {
    no: "03", title: "Personal Knowledge Graph",
    desc: "A self-hosted memory system built on Postgres, with automated ingestion and an LLM pipeline that turns raw captures into structured knowledge.",
  },
  {
    no: "04", title: "Automation and Retrieval",
    desc: "Custom n8n pipelines for document and video ingestion, plus a deterministic retrieval index built for auditable recall over ad-hoc similarity search.",
  },
];

const EDUCATION: Entry[] = [
  {
    name: "Master of Science in Information Management",
    org: "University of Washington. Data analytics and business intelligence, program and product management",
    yr: "2024",
  },
  {
    name: "Bachelor of Arts, Sociology and Statistics",
    org: "University of Minnesota. Quantitative methods, social research, and behavioral analysis",
    yr: "1991",
  },
];

const RECOGNITION: Entry[] = [
  {
    name: "Certificate of Appreciation",
    org: "NIA Division of Neuroscience, for contributions to NACC's Uniform Data Set v4",
    yr: "2021",
  },
  {
    name: "Board Member",
    org: "Delridge Neighborhood Development Association, a Seattle organization providing affordable housing and free arts, sports, and nature programming for young people",
    yr: "2015–2026",
  },
];

// Reverse chronological by start date, so the current role reads first.
const CAREER: Role[] = [
  { yr: "2021 — Present", role: "Communications & Funding Program Manager", org: "National Alzheimer's Coordinating Center" },
  { yr: "2012 — 2021", role: "Digital Marketing Agency Founder", org: "Zen Cloud Consulting" },
  { yr: "1996 — 2009", role: "Entrepreneur & Franchise Owner", org: "The Body Shop" },
  { yr: "1994 — 2011", role: "VP, Research & Partner", org: "CRG Research" },
];
---

<Layout title="About — Amy Young">

  <section class="sec">
    <div class="wrap">
      <header class="page-head">
        <div class="sh-label rv">About</div>
        <h1 class="page-title rv">Hi, I'm<br><strong>Amy Young.</strong></h1>
        <p class="page-lead rv">I'm a product manager and AI builder in Seattle. I love turning messy, complex problems into clear and useful products, and lately I've been just as focused on building the AI systems that get me there faster.</p>
        <p class="page-lead rv">Data, design, and communication have run through every job I've had, and AI agents now tie all three together. I run Claude Code as a daily driver: 30+ custom skills, deterministic hooks, and multi-agent routing across my own research, content, and ops. I designed and self-host a knowledge graph that captures raw research and compiles it into something I can query. I build things that make sense to the people using them, and that now includes the agents doing part of the work alongside me.</p>
      </header>
    </div>
  </section>

  <div class="sec-rule"></div>

  <section class="sec">
    <div class="wrap">
      <div class="sh">
        <div class="sh-label rv">Systems</div>
        <h2 class="sh-title rv">The systems I build and run.</h2>
        <p class="sh-desc rv">Every one of these is in daily use, running my own work rather than sitting in a demo.</p>
      </div>

      <div class="why-grid">
        {CAPABILITIES.map((c) => (
          <div class="why-card rv">
            <div class="why-n">{c.no}</div>
            <h3 class="why-t">{c.title}</h3>
            <p class="why-d">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="sec-rule"></div>

  <section class="sec">
    <div class="wrap">
      <div class="sh">
        <div class="sh-label rv">Background</div>
        <h2 class="sh-title rv">Education, awards, and community.</h2>
        <p class="sh-desc rv">Two degrees, one award from the NIA, and eleven years on a neighborhood board.</p>
      </div>

      <div class="awards-layout">
        <div>
          {EDUCATION.map((e) => (
            <div class="award rv">
              <span class="award-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z"></path><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"></path></svg>
              </span>
              <div>
                <div class="award-name">{e.name}</div>
                <div class="award-org">{e.org}</div>
              </div>
              <span class="award-yr">{e.yr}</span>
            </div>
          ))}
        </div>

        <div>
          {RECOGNITION.map((e) => (
            <div class="award rv">
              <span class="award-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"></circle><path d="M8.5 12.5L7 22l5-2.5L17 22l-1.5-9.5"></path></svg>
              </span>
              <div>
                <div class="award-name">{e.name}</div>
                <div class="award-org">{e.org}</div>
              </div>
              <span class="award-yr">{e.yr}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="sec-rule"></div>

  <section class="sec">
    <div class="wrap">
      <div class="sh">
        <div class="sh-label rv">Experience</div>
        <h2 class="sh-title rv">How I got here.</h2>
        <p class="sh-desc rv">Four stages: research, ownership, agency, and the work I do now.</p>
      </div>

      <div class="cj-list">
        {CAREER.map((r) => (
          <div class="cj-item rv">
            <div class="cj-yr">{r.yr}</div>
            <div>
              <h3 class="cj-role">{r.role}</h3>
              <div class="cj-org">{r.org}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
