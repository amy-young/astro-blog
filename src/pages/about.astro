interface Point  { k: string; v: string; }
interface Tool   { title: string; lede: string; points: Point[]; chips: string[]; }
interface Entry  { name: string; org: string; yr: string; }
interface Role   { yr: string; role: string; org: string; }

const SYSTEMS: System[] = [
  {
    n: "01", stat: "40+", statLabel: "custom skills authored",
    title: "Agent Environment",
    body: "Multi-agent routing across dev, content, research, and ops, model-agnostic underneath.",
    chips: ["Claude Code", "Subagents"],
  },
  {
    n: "02", stat: "100%", statLabel: "deterministic at the edges",
    title: "Harness and Hooks",
    body: "Permission tuning and a clear line between what gets automated and what stays with the model.",
    chips: ["Hooks", "Permissions"],
  },
  {
    n: "03", stat: "1,834", statLabel: "entities in the graph",
    title: "Personal Knowledge Graph",
    body: "Self-hosted memory on Postgres, with an LLM pipeline that turns raw captures into structure.",
    chips: ["Postgres", "MCP", "122 wiki pages"],
  },
  {
    n: "04", stat: "0", statLabel: "tokens to find a file",
    title: "Automation and Retrieval",
    body: "n8n ingestion pipelines plus a deterministic index built for auditable recall, not fuzzy guessing.",
    chips: ["n8n", "pka_retrieve"],
