---
import Layout from "../layouts/home.astro";
import { getCollection } from "astro:content";

function parseDate(dateStr: string) {
  const [month, day, year] = dateStr.split(" ");
  return new Date(`${month} ${parseInt(day)}, ${year}`);
}

const homeWriting = (await getCollection("post"))
  .map((post) => ({ ...post, date: parseDate(post.data.dateFormatted) }))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);
---

<Layout description="I build AI systems. Research first, then the system that meets the need. My own runs on persistent memory and rewrites its own playbook.">
{/* HERO */}
  <section class="hero">

    {/* LEFT: social, bio, big name */}
    <div class="hero-left">
      <div class="hero-social">
        <a class="sm-li" href="https://www.linkedin.com/in/amyyoung-data-ai/" target="_blank" rel="noopener">LinkedIn</a>,
        <a class="sm-bs" href="https://bsky.app/profile/amyyoung1.bsky.social" target="_blank" rel="noopener">Bluesky</a>,
        <a class="sm-gh" href="https://github.com/amy-young" target="_blank" rel="noopener">GitHub</a>,
        <a class="sm-x" href="https://x.com/amyyoung" target="_blank" rel="noopener">X / Twitter</a>
      </div>
      <p class="hero-bio">I build AI systems. Research first, then the system that meets the need. My own runs on persistent memory and rewrites its own playbook.</p>
      <div class="hero-name">Hello, I'm<br>Amy Young</div>
    </div>

    {/* CENTER: circular photo */}
    <div class="hero-center">
      <div class="hero-circle">
        <img src="/assets/images/home/amy-young-portrait.jpg" alt="Amy Young — UX Designer">
      </div>
    </div>

    {/* RIGHT: services, tagline, location */}
    <div class="hero-right">
      <div class="hero-services">
        <div class="hero-svc">
          <button class="hero-svc-btn" type="button" aria-expanded="false" aria-controls="svc-ai"><span class="plus">+</span> AI Systems</button>
          <div class="hero-svc-panel" id="svc-ai"><p>Agentic workflows, retrieval pipelines, and automation that runs in production rather than in a demo. Two years building a system that orchestrates my own work: persistent memory across sessions, automated capture and routing, processes that update themselves as I learn.</p></div>
        </div>
        <div class="hero-svc">
          <button class="hero-svc-btn" type="button" aria-expanded="false" aria-controls="svc-ps"><span class="plus">+</span> Product Strategy</button>
          <div class="hero-svc-panel" id="svc-ps"><p>Deciding what to build and why, from problem framing through roadmap, scope, and the tradeoffs nobody wants to make.</p></div>
        </div>
        <div class="hero-svc">
          <button class="hero-svc-btn" type="button" aria-expanded="false" aria-controls="svc-ra"><span class="plus">+</span> Research &amp; Analytics</button>
          <div class="hero-svc-panel" id="svc-ra"><p>Mixed-methods research and the data work behind it. Evidence that changes decisions, not decks that get filed.</p></div>
        </div>
      </div>
      <div class="hero-right-bottom" style="text-align:right; width:100%;">
        <p class="hero-tagline">The hard part isn't adding AI.<br>It's knowing which parts should never touch it.</p>
        <div class="hero-location">Based in<br>Seattle, WA</div>
      </div>
    </div>

  </section>

  <div style="height:1px; background:var(--border); width:100%;"></div>

  {/* XENON AI SECTION */}
  <section class="xn-sec">
    <div class="wrap">
      <div class="xn-headline rv">The workshop side of<br><strong>Artificial Intelligence.</strong></div>
      <div class="xn-main">
        {/* The PKA system's five stages, as markup rather than an image. The full
             diagram moved to /project/personal-knowledge-system on 2026-08-06: at this
             column width its labels read as texture, and its baked-in headline competed
             with the section headline above. Numbered because the order is real. */}
        <div class="xn-system">
          <div class="xn-system-lbl">Personal knowledge and AI operating system</div>
          <p class="xn-system-lead">Everything I capture <strong>becomes structure.</strong></p>
          <p class="xn-system-sub">Meetings, documents, research, and voice notes route through one pipeline into a Postgres brain I host myself. It extracts the entities, compiles the wiki, and hands back the right file in zero tokens.</p>
          <ol class="xn-flow">
            <li class="xn-flow-step"><span class="xn-flow-n">01</span><span class="xn-flow-name">Capture</span><span class="xn-flow-sub">Seven surfaces. Everything in.</span></li>
            <li class="xn-flow-step"><span class="xn-flow-n">02</span><span class="xn-flow-name">Process</span><span class="xn-flow-sub">Clean. Enrich. Structure.</span></li>
            <li class="xn-flow-step"><span class="xn-flow-n">03</span><span class="xn-flow-name">Store</span><span class="xn-flow-sub">Postgres and pgvector.</span></li>
            <li class="xn-flow-step"><span class="xn-flow-n">04</span><span class="xn-flow-name">Synthesize</span><span class="xn-flow-sub">Entities. Edges. Wiki.</span></li>
            <li class="xn-flow-step"><span class="xn-flow-n">05</span><span class="xn-flow-name">Retrieve</span><span class="xn-flow-sub">Deterministic. Relevant.</span></li>
          </ol>
          {/* Real counts from the system map, verified 2026-08-05. Not the fabricated
               stats bar that was cut on 2026-08-03. */}
          <dl class="xn-stats">
            <div class="xn-stat"><dt class="xn-stat-n">1,834</dt><dd class="xn-stat-l">entities extracted</dd></div>
            <div class="xn-stat"><dt class="xn-stat-n">2,034</dt><dd class="xn-stat-l">typed edges</dd></div>
            <div class="xn-stat"><dt class="xn-stat-n">122</dt><dd class="xn-stat-l">wiki pages compiled</dd></div>
            <div class="xn-stat"><dt class="xn-stat-n">0</dt><dd class="xn-stat-l">tokens to find a file</dd></div>
          </dl>
          <a class="xn-system-link" href="/project/personal-knowledge-system">See the full architecture <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
        <div class="xn-info rv">
          <div class="xn-arrows">►►</div>
          <div class="xn-name-lbl">I'm Amy Young</div>
          <div class="xn-role-big">Researcher.<br>Designer.<br>Builder.</div>
          <div class="xn-role-desc">I research where AI is heading, design what it makes possible, and build it.</div>
          <div class="xn-scroll"><span class="xn-scroll-arrow">↓</span>Scroll</div>
        </div>
      </div>
      <div class="xn-about rv">
        <div>
          <div class="xn-about-lbl">I'm Amy Young</div>
          <img src="/assets/images/home/amy-young-sailing.jpg" alt="Amy Young" class="xn-about-photo">
        </div>
        <div>
          <div class="xn-about-label">About</div>
          <p class="xn-about-text">I came up through <strong>market research and data analytics</strong>, then digital marketing, where research met brand and web design. Today I work in <strong>information management and communications for a national research center</strong>. A master's in Information Management from UW pointed me at AI, and I've been <strong>building AI systems and teaching colleagues to do the same</strong> ever since.</p>
        </div>
      </div>
    </div>
  </section>


