  {/* MY WORKSHOP — two featured projects. Rebuilt 2026-08-04 with Amy's own project data
       (2026-07-14 export). Metric pairs deliberately omitted: they were the cut stat line
       redistributed to card level. */}
  <section class="sec sec-white wrap">
    <div class="sh rv sh-row">
      <div><div class="sh-label">My Workshop</div><div class="sh-title" style="margin-bottom:0;">Start with these.</div></div>
      <a class="btn btn-outline" href="/projects">View All Projects</a>
    </div>
    <div class="feat-stack">
      {/* PKA leads (Amy's call 2026-08-06), image left / copy right. Text-box theme flipped
           2026-08-17: the hero image is dark on its own, so the text side went light (tint
           gradient) as a counterweight instead of doubling down on dark. Card-level background
           (.feat-card-dark, below) stays dark regardless — that's tuned to blend with the dark
           image's own letterbox slack, independent of the text box's theme.
           VPS Lab got the same treatment 2026-08-18 once its own image became a dark hero
           graphic too — both cards now use the same "dark image, light text" formula rather
           than being a contrasting light/dark pair. */}
      <div class="feat-card feat-card-dark rv">
        <div class="feat-img-wrap"><img src="/assets/images/projects/pka-system-hero.webp" alt="Personal Knowledge System"></div>
        <div class="feat-body feat-body-tint">
          <div class="feat-cat">Knowledge · Building</div>
          <div class="feat-title">Personal Knowledge System</div>
          <div class="feat-desc">A system for capturing, organizing, and surfacing knowledge across research, projects, and interests.</div>
          <a href="/project/personal-knowledge-system" class="feat-link">Walk through the build <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
      <div class="feat-card feat-card-dark rv">
        {/* Was "ADRD Researcher Community" until 2026-08-06. That label was wrong twice
             over: it implied a Discourse-style community platform Amy never ran, and it
             was conflating the NACC Directory with the ADRD funding platform. Amy's call
             was to feature the VPS lab here instead.
             Image replaced 2026-08-18 (was a light stock photo, now a dark-navy hero
             graphic matching PKA's style) — text-box theme flipped from dark back to
             .feat-body-tint (light) to match, same "dark image needs a light counterweight"
             call as PKA. .feat-card-dark added so the card-level background (behind the
             image's letterbox slack) matches the new dark image instead of the old default
             light background, which was tuned for the light photo. */}
        <div class="feat-body feat-body-tint">
          <div class="feat-cat">Infrastructure · Shipped</div>
          <div class="feat-title">Self-Hosted VPS Lab</div>
          <div class="feat-desc">Docker and Caddy on a personal VPS: Postgres with pgvector, n8n automation, Vikunja, KaraKeep, and both of my sites, behind Tailscale.</div>
          <a href="/projects" class="feat-link">See the stack <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
        <div class="feat-img-wrap"><img src="/assets/images/projects/vps-lab-hero.webp" alt="Self-Hosted VPS Lab"></div>
      </div>
    </div>
  </section>

  {/* PROJECT GRID removed 2026-08-06 (Amy's call). The six cards duplicated what "My
       Workshop" already does, and its "View All Projects" pill moved up into the Workshop
       header. The .proj-* styles are left in home.css on purpose: the /projects rebuild in
       this design system is the next piece of work and will reuse them. */}
  {/* EDUCATION section removed 2026-08-04 — relocated to the About page (Amy's call).
       Real data recovered from the 2026-07-14 export: M.S. Information Management, UW (2024);
       B.A. Sociology & Statistics, University of Minnesota (1991); NIA Certificate of
       Appreciation, UDS v4 (2021); Board Member, Delridge Neighborhood Development Assn (2015-2026). */}
  {/* WRITING — rebuilt 2026-08-16 with real posts, replacing the DO NOT SHIP placeholder
       cards. Renders whatever's real (three, currently) and nothing else -- same call as
       /projects: a short row of genuine work reads as early-stage, a fake card reads as
       padding. */}
  <section class="sec sec-rule">
    <div class="wrap">
      {/* The "All Articles" pill moved below the grid as a text link 2026-08-06: it was
           competing with the longer headline, and a "see more" belongs after the thing it
           expands. Matches the .feat-link / .xn-system-link treatment used elsewhere. */}
      <div class="sh rv">
        <div class="sh-label">Writing</div>
        <div class="sh-title">What I'm reading, building, and thinking about.</div>
      </div>
      <div class="blog-grid">
        {homeWriting.map((post) => (
          <a href={`/post/${post.slug}`} class="blog-card rv">
            {post.data.heroImage && (
              <div class="blog-img"><img src={post.data.heroImage} alt="" loading="lazy" decoding="async" width="640" height="360" /></div>
            )}
            <div class="blog-body">
              {post.data.tags && post.data.tags[0] && <div class="blog-cat">{post.data.tags[0]}</div>}
              <div class="blog-title">{post.data.title}</div>
              <div class="blog-meta">{post.data.dateFormatted}</div>
            </div>
          </a>
        ))}
      </div>
      <a class="sec-more rv" href="/posts">See all articles <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
  </section>
  {/* STATS BAR removed 2026-08-03 — fabricated placeholder */}
  {/* TESTIMONIALS removed 2026-08-03 — fabricated placeholder */}
</Layout>
