---
import { getCollection } from "astro:content";
import Layout from "../layouts/home.astro";

// Rebuilt 2026-08-16 onto the home.astro design system, per
// handoff/posts-index-redesign/README.md in the PKA repo. Replaces the Aria/Tailwind
// build (dark-mode classes, hardcoded tagColors/cardGradients maps, client-side tag
// filter, Why I Write callout banner) — none of that carries over.
//
// Tag filter held: with two posts a filter has nothing to filter. /projects already
// ships the real pattern (.pj-filter/.pj-chip) if the count ever justifies porting it.
//
// Why I Write callout dropped: that content becomes its own post (deliverable 2 of the
// handoff) and no longer belongs here as a banner.

interface Post {
  slug: string;
  data: {
    title: string;
    description: string;
    dateFormatted: string;
    tags?: string[];
    heroImage?: string;
  };
}

function parseDate(dateStr: string) {
  const [month, day, year] = dateStr.split(" ");
  return new Date(`${month} ${parseInt(day)}, ${year}`);
}

const allPosts = (await getCollection("post")) as Post[];

const sorted = allPosts
  .map((post) => ({ ...post, date: parseDate(post.data.dateFormatted), link: `/post/${post.slug}` }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

// Featured post is a deliberate editorial call (Amy, 2026-08-16), not "whatever sorts
// first" — both real posts currently carry the same dateFormatted, so sort order can't
// break the tie anyway.
const featured = sorted.find((p) => p.slug === "the-system-that-knows-you") ?? sorted[0];
const rest = sorted.filter((p) => p.slug !== featured?.slug);
---

<Layout
  title="Writing — Amy Young"
  description="Field notes from the build. What I'm learning building with AI across research, data, and communications, written as I go."
>
  <section class="sec">
    <div class="wrap">

      <header class="page-head">
        <div class="sh-label rv">Writing</div>
        <h1 class="page-title rv">Field notes from<br><strong>the build.</strong></h1>
        <p class="page-lead rv">What I'm learning building with AI across research, data, and communications.</p>
      </header>

      {featured && (
        <a href={featured.link} class={`wr-feat rv${featured.data.heroImage ? " wr-feat-media" : ""}`}>
          {featured.data.heroImage && (
            <div class="wr-feat-img-wrap">
              <img src={featured.data.heroImage} alt="" loading="lazy" decoding="async" width="640" height="480" />
            </div>
          )}
          <div class="wr-feat-body">
            <div class="sh-label">Featured</div>
            <h2 class="feat-title">{featured.data.title}</h2>
            <p class="wr-feat-desc">{featured.data.description}</p>
            <div class="post-meta">
              <time class="post-date">{featured.data.dateFormatted}</time>
              {featured.data.tags && featured.data.tags.length > 0 && (
                <div class="post-tags">
                  {featured.data.tags.slice(0, 3).map((t) => <span class="tag tag-accent">{t}</span>)}
                </div>
              )}
              <span class="pj-go">Read article <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
            </div>
          </div>
        </a>
      )}

    </div>
  </section>

  {rest.length > 0 && (
    <>
      <div class="sec-rule"></div>
      <section class="sec">
        <div class="wrap">
          <div class="blog-grid">
            {rest.map((post) => (
              <a href={post.link} class="blog-card rv">
                {post.data.heroImage && (
                  <div class="blog-img"><img src={post.data.heroImage} alt="" loading="lazy" decoding="async" width="640" height="360" /></div>
                )}
                <div class="blog-body">
                  {post.data.tags && post.data.tags[0] && <div class="blog-cat">{post.data.tags[0]}</div>}
                  <div class="blog-title">{post.data.title}</div>
                  <div class="blog-meta">{post.data.dateFormatted}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </>
  )}
</Layout>
