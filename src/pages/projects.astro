---
import Layout from "../layouts/home.astro";

// Rebuilt 2026-08-06 in the homepage design system, replacing the Aria-theme page.
// Data reconciled against the current ventures registry and thread files rather than
// ported straight from the 2026-07-14 export, which had drifted in six places.
//
// Reconciliation notes:
//  - "ADRD Researcher Community" + "Researcher Profile App" were the same system, and
//    both were mislabelled: the real work is the NACC Directory. Merged and reframed.
//  - "ADRD Research Hub" is the ADRD research funding platform (thread name: neuspace).
//    Displayed descriptively until the domain is registered — see the thread file.
//  - Personal Knowledge System was "building"; it runs Amy's whole operation. Shipped.
//  - Publications Intelligence was missing from the export entirely. Added.
//
// Amy's rulings 2026-08-07 (do not silently restore these):
//  - Women's Sports Blog, Memory Care Directory and Family Law Directory REMOVED. She does
//    not want unlaunched ideas public until they ship.
//  - Travel Companion App and Package & Delivery Tracker KEPT, with hero art, under their
//    generic names rather than their product names. Concept cards self-label "Design concept"
//    off the status field, because the mockups are drawn as live product marketing.
//  - NACC Website REMOVED until the redesign is complete.
//  - The "amyyoung.me" card REMOVED as self-referential; the reader is already on it.
//  - YouTube Capture Pipeline ADDED. 2026-10-29: repo public, and the card now links to its
//    detail page (/project/youtube-capture-pipeline), which links GitHub. goLabel removed.
//
// Amy's ruling 2026-08-20: Publications Intelligence REMOVED (was card 06). Set aside until
// Amy has time to work through the development plan — same "not public until ready" rule as
// the 08-07 removals. The detail page (src/content/project/publications-intelligence.md) and
// the handoff (handoff/publications-intelligence-project-page/README.md) are left in place,
// just unlinked — don't delete that work, don't silently re-add the card either.
//
// Amy's rulings 2026-11-06:
//  - Card 05 renamed "Build Your Own AI Operating System" (was "AI Learning Platform") and set to
//    its own status: it's one-to-one training she is running now, not a build in progress.
//    (Named "active" first; renamed "beta" 2026-11-07 because "active" implied the others weren't.)
//  - Memory Care Center RE-ADDED as card 06, status "building", reversing the 08-07 removal at
//    her explicit request.
//
// Amy's rulings 2026-11-07: ADRD funding platform moves to "building"; the travel app gets the new
// "designed" status (a finished design, not just an idea); the package tracker stays "concept".
// Designed cards carry the same "Design concept" image caption as concept cards, because their
// mockups are also drawn as live product marketing.
//
// Ordered shipped -> beta -> building -> designed -> concept, so the page opens on what actually exists.

type Status = "shipped" | "beta" | "building" | "designed" | "concept";

interface Project {
  no: string;
  cat: string;
  status: Status;
  name: string;
  desc: string;
  meta: string;
  url?: string;
  goLabel?: string;
  /* Card art. Amy is making images for every card before the site goes live, so this is
     optional for now and cards without it simply render text-forward as before. */
  img?: string;
  imgAlt?: string;
}

const PROJECTS: Project[] = [
  {
    no: "01", cat: "Database", status: "shipped", name: "NACC Directory", meta: "Product Manager",
    desc: "REDCap-backed CRM connecting Alzheimer's disease researchers across 37 ADRCs nationwide. Ten forms and 1,600+ fields tracking expertise, leadership, and committee service, routing access to the NACC Data Platform, the Discourse community, and the rest of NACC's researcher resources. Updated in real time.",
    img: "/assets/images/projects/nacc-directory-hero.webp",
    imgAlt: "NACC Directory title card: 'Building the Infrastructure Behind Alzheimer's Research Collaboration — Connecting expertise across the ADRC network to identify the right people for the work,' over a network diagram of connected researcher nodes.",
  },
  {
    no: "02", cat: "Knowledge", status: "shipped", name: "Personal Knowledge System", meta: "Personal build",
    desc: "The AI operating system I run my own work on. Seven capture surfaces feed one pipeline into a self-hosted Postgres brain that extracts entities, compiles a wiki, and returns the right file in zero tokens.",
    url: "/project/personal-knowledge-system",
    img: "/assets/images/projects/pka-system-hero-v3.webp",
    imgAlt: "A 3D visualization of a glowing neural network rising from a database, styled as the Personal Knowledge System's hero art, with the title 'My personal knowledge + AI operating system.'",
  },
  {
    no: "03", cat: "Infrastructure", status: "shipped", name: "Self-Hosted VPS Lab", meta: "Self-hosted",
    desc: "A personal VPS running Docker and Caddy: Postgres with pgvector, n8n automation, Vikunja, KaraKeep, and both of my sites, behind Tailscale.",
    url: "/project/self-hosted-vps-lab",
    img: "/assets/images/projects/vps-lab-hero-v5.webp",
    imgAlt: "Title card reading 'A server you control beats five tools you don't,' over a labeled grid of services running on the box (Caddy, Docker, n8n, OpenBrain, Vikunja, Tailscale, KaraKeep) and a diagram of a VPS connecting to cloud servers.",
  },
  {
    no: "04", cat: "Automation", status: "shipped", name: "YouTube Capture Pipeline", meta: "Personal build",
    url: "/project/youtube-capture-pipeline",
    desc: "Save a YouTube video from my phone and wake up to a summary, the resources it mentioned pulled out, and the good material filed into my knowledge base on its own. n8n, yt-dlp, and Gemini, running on my own VPS.",
    img: "/assets/images/projects/youtube-capture-pipeline-hero-v2.webp",
    imgAlt: "A grid of video cells with one lit, beside the line 'Save it on the couch. Find it filed by morning.'",
  },
  {
    no: "05", cat: "Education", status: "beta", name: "Build Your Own AI Operating System", meta: "One-to-one training",
    desc: "I train people one to one to build their own AI operating system: plain files that tell their AI who they are, which parts of their life it covers, and what it must never touch. We start from a questionnaire, build the core together in one session, and add to it as their work grows. Works with Claude, ChatGPT, or an open-source model running on their own computer.",
    img: "/assets/images/projects/ai-operating-system-hero-v1.webp",
    imgAlt: "Folders for work, writing and home connected to a file box holding 'About me' and 'My routines' cards, with a morning brief checklist, a calendar and a locked folder, beside the line 'Your AI. Built around you.'",
  },
  {
    no: "06", cat: "Directory", status: "building", name: "Memory Care Center", meta: "Venture build",
    desc: "I'm building one clear place for Washington families to find memory care, from official state and federal licensing and inspection data. Certification, cost range, Medicaid and inspection history are free on every listing. Families contact only the facility they choose, and their information is never sold or shared. Astro and Postgres with PostGIS, on my own VPS.",
    img: "/assets/images/projects/memory-care-center-hero-v1.webp",
    imgAlt: "A map of Washington with location pins, a memory care listing card showing licensing, Medicaid and inspection history, an inspection records panel and a 'Your choice' card with a lock, beside the line 'Find care. See the full picture.'",
  },
  {
    no: "07", cat: "Discovery", status: "building", name: "ADRD Research Funding Platform", meta: "Product Design",
    desc: "I'm designing a funding platform just for Alzheimer's and related dementias research. Opportunities from NIH, foundations and international funders arrive as a digest matched to each researcher's work, with funding trends, funder spotlights and a deadline calendar alongside. Funding information stays free for researchers.",
    img: "/assets/images/projects/adrd-research-funding-hero-v1.webp",
    imgAlt: "An open notebook linking a research profile to a highlighted research opportunity marked 'Match', with a funding trends chart and a desk calendar with deadlines marked, beside the line 'The right funding finds you.'",
  },
  {
    no: "08", cat: "Mobile", status: "designed", name: "Travel Companion App", meta: "Product Design",
    desc: "I designed one workspace for a whole trip. Every flight, hotel, train, tour and reservation sits in a single itinerary, each marked confirmed, booked or still to book, so planning no longer lives across spreadsheets, browser tabs and inbox searches.",
    img: "/assets/images/projects/travel-companion-hero.png",
    imgAlt: "Landing page design for the travel companion app, showing a trip itinerary with flights, hotels, and bookings tracked by status.",
  },
  {
    no: "09", cat: "Dashboard", status: "concept", name: "Package & Delivery Tracker", meta: "Product Design",
    desc: "I'm exploring one dashboard for every delivery, from every retailer. Forward or connect your order emails, and it pulls out the tracking numbers, follows each carrier and alerts you when something changes. Shaped with caregivers in mind, including adult children managing deliveries for a parent.",
    img: "/assets/images/projects/package-tracker-hero.png",
    imgAlt: "Landing page design for the package tracker, showing a delivery dashboard with packages grouped by in transit, out for delivery, and delivered.",
  },
];

const STATUS_LABEL: Record<Status, string> = {
  shipped: "Shipped",
  beta: "Beta",
  building: "Building",
  designed: "Designed",
  concept: "Concept",
};

const counts = {
  all: PROJECTS.length,
  shipped: PROJECTS.filter((p) => p.status === "shipped").length,
  beta: PROJECTS.filter((p) => p.status === "beta").length,
  building: PROJECTS.filter((p) => p.status === "building").length,
  designed: PROJECTS.filter((p) => p.status === "designed").length,
  concept: PROJECTS.filter((p) => p.status === "concept").length,
};

const FILTERS: [string, string][] = [
  ["all", "All"],
  ["shipped", "Shipped"],
  ["beta", "Beta"],
  ["building", "Building"],
  ["designed", "Designed"],
  ["concept", "Concept"],
];
---

<Layout
  title="Projects — Amy Young"
  description="Research, data, and AI tools I've designed and built to make complex information easier to work with. Some shipped and in daily use, some still in progress."
>
  <section class="sec">
    <div class="wrap">

      <header class="page-head">
        <div class="sh-label rv">Latest work</div>
        <h1 class="page-title rv">Things I've<br><strong>designed and built.</strong></h1>
        <p class="page-lead rv">I build tools that make complex information easier to work with. Some are shipped and in daily use, some are in progress, and some are designs waiting for their turn. Every one started with a problem worth solving.</p>

        <dl class="xn-stats pj-stats page-stats rv">
          <div class="xn-stat"><dt class="xn-stat-n">{counts.all}</dt><dd class="xn-stat-l">projects</dd></div>
          <div class="xn-stat"><dt class="xn-stat-n">{counts.shipped}</dt><dd class="xn-stat-l">shipped</dd></div>
          <div class="xn-stat"><dt class="xn-stat-n">{counts.beta}</dt><dd class="xn-stat-l">beta</dd></div>
          <div class="xn-stat"><dt class="xn-stat-n">{counts.building}</dt><dd class="xn-stat-l">building</dd></div>
          <div class="xn-stat"><dt class="xn-stat-n">{counts.designed}</dt><dd class="xn-stat-l">designed</dd></div>
          <div class="xn-stat"><dt class="xn-stat-n">{counts.concept}</dt><dd class="xn-stat-l">concept</dd></div>
        </dl>
      </header>

      <div class="pj-filter rv">
        <span class="pj-filter-lbl">Filter</span>
        {FILTERS.map(([key, label]) => (
          <button class="pj-chip" type="button" data-filter={key} aria-pressed={key === "all"}>
            {label} <span class="pj-chip-n">{counts[key as keyof typeof counts]}</span>
          </button>
        ))}
      </div>

      <ul class="pj-grid" id="pj-grid">
        {PROJECTS.map((p) => {
          const Tag = p.url ? "a" : "div";
          return (
            <li class="pj-item rv" data-status={p.status}>
              <Tag class="pj-card" {...(p.url ? { href: p.url } : {})} {...(p.url?.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
                {p.img && (
                  <div class="pj-media">
                    <img src={p.img} alt={p.imgAlt ?? ""} loading="lazy" decoding="async" width="640" height="360" />
                    {(p.status === "concept" || p.status === "designed") && <span class="pj-media-cap">Design concept</span>}
                  </div>
                )}
                <div class="pj-top">
                  <span class="pj-no">{p.no}</span>
                  <span class="pj-cat">{p.cat}</span>
                  <span class="pj-status" data-s={p.status}><span class="pj-dot"></span>{STATUS_LABEL[p.status]}</span>
                </div>
                <h2 class="pj-name">{p.name}</h2>
                <p class="pj-desc">{p.desc}</p>
                <div class="pj-foot">
                  <span class="pj-meta">{p.meta}</span>
                  {p.url && (
                    <span class="pj-go">{p.goLabel ?? "Walk through the build"} <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
                  )}
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>

      <p class="pj-empty" id="pj-empty" hidden>Nothing in that stage right now.</p>

    </div>
  </section>
</Layout>

<script>
  const grid = document.getElementById('pj-grid');
  const empty = document.getElementById('pj-empty');
  const chips = Array.from(document.querySelectorAll('.pj-chip'));

  if (grid && chips.length) {
    const items = Array.from(grid.querySelectorAll('.pj-item'));

    const apply = (filter: string) => {
      let shown = 0;
      items.forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const match = filter === 'all' || el.dataset.status === filter;
        el.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c instanceof HTMLElement && c.dataset.filter === filter)));
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (chip instanceof HTMLElement && chip.dataset.filter) apply(chip.dataset.filter);
      });
    });
  }
</script>
