---
import Layout from "../layouts/home.astro";

// Rebuilt 2026-08-06 in the homepage design system, replacing the Aria-theme page.
// Data reconciled against the current ventures registry and thread files rather than
// ported straight from the 2026-07-14 export, which had drifted in six places.
//
// Reconciliation notes:
//  - "ADRD Researcher Community" + "Researcher Profile App" were the same system, and
//    both were mislabelled: the real work is the NACC Directory. Merged and reframed.
//  - "ADRD Research Hub" is the ADRD research funding platform (thread name: neuspace).
//    Displayed descriptively until the domain is registered — see the thread file.
//  - Personal Knowledge System was "building"; it runs Amy's whole operation. Shipped.
//  - Publications Intelligence was missing from the export entirely. Added.
//
// Amy's rulings 2026-08-07 (do not silently restore these):
//  - Women's Sports Blog, Memory Care Directory and Family Law Directory REMOVED. She does
//    not want unlaunched ideas public until they ship.
//  - Travel Companion App and Package & Delivery Tracker KEPT, with hero art, under their
//    generic names rather than their product names. Concept cards self-label "Design concept"
//    off the status field, because the mockups are drawn as live product marketing.
//  - NACC Website REMOVED until the redesign is complete.
//  - The "amyyoung.me" card REMOVED as self-referential; the reader is already on it.
//  - YouTube Capture Pipeline ADDED. Link it once github.com/amy-young/youtube-capture-pipeline
//    is flipped public; it is private as of this writing.
//
// Ordered shipped -> building -> concept, so the page opens on what actually exists.

type Status = "shipped" | "building" | "concept";

interface Project {
  no: string;
  cat: string;
  status: Status;
  name: string;
  desc: string;
  meta: string;
  url?: string;
  /* Card art. Amy is making images for every card before the site goes live, so this is
     optional for now and cards without it simply render text-forward as before. */
  img?: string;
  imgAlt?: string;
}

const PROJECTS: Project[] = [
  {
    no: "01", cat: "Database", status: "shipped", name: "NACC Directory", meta: "Product Manager",
    desc: "REDCap-backed CRM connecting Alzheimer's disease researchers across 37 ADRCs nationwide. Ten forms and 1,600+ fields tracking expertise, leadership, and committee service, routing access to the NACC Data Platform, the Discourse community, and the rest of NACC's researcher resources. Updated in real time.",
    img: "/assets/images/projects/nacc-directory-hero.webp",
    imgAlt: "NACC Directory title card: 'Building the Infrastructure Behind Alzheimer's Research Collaboration — Connecting expertise across the ADRC network to identify the right people for the work,' over a network diagram of connected researcher nodes.",
  },
  {
    no: "02", cat: "Knowledge", status: "shipped", name: "Personal Knowledge System", meta: "Personal build",
    desc: "The AI operating system I run my own work on. Seven capture surfaces feed one pipeline into a self-hosted Postgres brain that extracts entities, compiles a wiki, and returns the right file in zero tokens.",
    url: "/project/personal-knowledge-system",
    img: "/assets/images/projects/pka-system-hero.webp",
    imgAlt: "A 3D visualization of a glowing neural network rising from a database, styled as the Personal Knowledge System's hero art, with the title 'My personal knowledge + AI operating system.'",
  },
  {
    no: "03", cat: "Infrastructure", status: "shipped", name: "Self-Hosted VPS Lab", meta: "Self-hosted",
    desc: "A personal VPS running Docker and Caddy: Postgres with pgvector, n8n automation, Vikunja, KaraKeep, and both of my sites, behind Tailscale.",
  },
  {
    no: "04", cat: "Automation", status: "shipped", name: "YouTube Capture Pipeline", meta: "Personal build",
    desc: "Save a YouTube video from my phone and wake up to a summary, the resources it mentioned pulled out, and the good material filed into my knowledge base on its own. n8n, yt-dlp, and Gemini, running on my own VPS.",
  },
  {
    no: "05", cat: "Education", status: "building", name: "AI Learning Platform", meta: "Concept to MVP",
    desc: "A curriculum and delivery repo for teaching colleagues practical AI agent and automation skills, built from what actually worked in my own practice.",
  },
  {
    no: "06", cat: "Data", status: "building", name: "Publications Intelligence", meta: "Product + Design",
    desc: "A queryable database of research published using NACC data, with a companion for handling data requests. Postgres and pgvector, with separate public and internal data planes.",
  },
  {
    no: "07", cat: "Discovery", status: "concept", name: "ADRD Research Funding Platform", meta: "Product Design",
    desc: "Funding opportunities, training programs, and job openings for ADRD researchers in one place. AI-native rather than a site with AI added on: a standing profile-match feed instead of a search box.",
  },
  {
    no: "08", cat: "Mobile", status: "concept", name: "Travel Companion App", meta: "Product Design",
    desc: "Trip organizer with itinerary management, fellow traveler insights, and travel loyalty points optimization.",
    img: "/assets/images/projects/travel-companion-hero.png",
    imgAlt: "Landing page design for the travel companion app, showing a trip itinerary with flights, hotels, and bookings tracked by status.",
  },
  {
    no: "09", cat: "Dashboard", status: "concept", name: "Package & Delivery Tracker", meta: "Product Design",
    desc: "Unified dashboard to track purchases from multiple vendors and coordinate deliveries across locations.",
    img: "/assets/images/projects/package-tracker-hero.png",
    imgAlt: "Landing page design for the package tracker, showing a delivery dashboard with packages grouped by in transit, out for delivery, and delivered.",
  },
];

const STATUS_LABEL: Record<Status, string> = {
  shipped: "Shipped",
  building: "Building",
  concept: "Concept",
};

const counts = {
  all: PROJECTS.length,
  shipped: PROJECTS.filter((p) => p.status === "shipped").length,
  building: PROJECTS.filter((p) => p.status === "building").length,
  concept: PROJECTS.filter((p) => p.status === "concept").length,
};

const FILTERS: [string, string][] = [
  ["all", "All"],
  ["shipped", "Shipped"],
  ["building", "Building"],
  ["concept", "Concept"],
];
---

<Layout title="Projects — Amy Young">
  <section class="sec">
    <div class="wrap">

      <header class="page-head">
        <div class="sh-label rv">Latest work</div>
        <h1 class="page-title rv">Things I've<br><strong>designed and built.</strong></h1>
        <p class="page-lead rv">I build tools that make complex information easier to work with. Some are shipped and in daily use, some are in progress, and some are designs waiting for their turn. Every one started with a problem worth solving.</p>

        <dl class="xn-stats page-stats rv">
          <div class="xn-stat"><dt class="xn-stat-n">{counts.all}</dt><dd class="xn-stat-l">projects</dd></div>
          <div class="xn-stat"><dt class="xn-stat-n">{counts.shipped}</dt><dd class="xn-stat-l">shipped</dd></div>
          <div class="xn-stat"><dt class="xn-stat-n">{counts.building}</dt><dd class="xn-stat-l">building</dd></div>
          <div class="xn-stat"><dt class="xn-stat-n">{counts.concept}</dt><dd class="xn-stat-l">concept</dd></div>
        </dl>
      </header>

      <div class="pj-filter rv">
        <span class="pj-filter-lbl">Filter</span>
        {FILTERS.map(([key, label]) => (
          <button class="pj-chip" type="button" data-filter={key} aria-pressed={key === "all"}>
            {label} <span class="pj-chip-n">{counts[key as keyof typeof counts]}</span>
          </button>
        ))}
      </div>

      <ul class="pj-grid" id="pj-grid">
        {PROJECTS.map((p) => {
          const Tag = p.url ? "a" : "div";
          return (
            <li class="pj-item rv" data-status={p.status}>
              <Tag class="pj-card" {...(p.url ? { href: p.url } : {})}>
                {p.img && (
                  <div class="pj-media">
                    <img src={p.img} alt={p.imgAlt ?? ""} loading="lazy" decoding="async" width="640" height="360" />
                    {p.status === "concept" && <span class="pj-media-cap">Design concept</span>}
                  </div>
                )}
                <div class="pj-top">
                  <span class="pj-no">{p.no}</span>
                  <span class="pj-cat">{p.cat}</span>
                  <span class="pj-status" data-s={p.status}><span class="pj-dot"></span>{STATUS_LABEL[p.status]}</span>
                </div>
                <h2 class="pj-name">{p.name}</h2>
                <p class="pj-desc">{p.desc}</p>
                <div class="pj-foot">
                  <span class="pj-meta">{p.meta}</span>
                  {p.url && (
                    <span class="pj-go">Take it apart <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
                  )}
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>

      <p class="pj-empty" id="pj-empty" hidden>Nothing in that stage right now.</p>

    </div>
  </section>
</Layout>

<script>
  const grid = document.getElementById('pj-grid');
  const empty = document.getElementById('pj-empty');
  const chips = Array.from(document.querySelectorAll('.pj-chip'));

  if (grid && chips.length) {
    const items = Array.from(grid.querySelectorAll('.pj-item'));

    const apply = (filter: string) => {
      let shown = 0;
      items.forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const match = filter === 'all' || el.dataset.status === filter;
        el.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c instanceof HTMLElement && c.dataset.filter === filter)));
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (chip instanceof HTMLElement && chip.dataset.filter) apply(chip.dataset.filter);
      });
    });
  }
</script>
